# ── NCR API 서버 ──────────────────────────────────────────────────────
# RPA가 실행되는 PC에서 접근 가능한 서버 주소
NCR_API_BASE=http://localhost:3000

# 서버 측 공유 시크릿 (추후 구현)
NCR_API_SECRET=

# ── UNIERP 실행 설정 ──────────────────────────────────────────────────
# UNIERP 실행 파일 전체 경로 (settings.json의 launch.exe_path보다 우선)
UNIERP_EXE_PATH=C:\UNIERP\UNIERP.exe

# UNIERP 로그인 자격증명 (settings.json의 launch.username/password보다 우선)
UNIERP_USERNAME=
UNIERP_PASSWORD=

# ── 디버그 ────────────────────────────────────────────────────────────
# DEBUG=1 로 설정하면 상세 로그 출력
DEBUG=
